generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  FINISHED
  CANCELLED
}

enum GuestStatus {
  ACTIVE
  USED
  CANCELLED
}

model Event {
  id            String      @id @default(uuid())
  slug          String      @unique
  name          String
  description   String
  imageUrl      String?     @map("image_url")
  startsAt      DateTime    @map("starts_at")
  venue         String
  priceInCents  Int         @map("price_in_cents")
  totalTickets  Int         @map("total_tickets")
  issuedTickets Int         @default(0) @map("issued_tickets")
  status        EventStatus @default(ACTIVE)
  termsOfUse    String      @map("terms_of_use")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  guests        Guest[]

  @@index([status, startsAt])
  @@map("events")
}

model Guest {
  id            String      @id @default(uuid())
  eventId       String      @map("event_id")
  eventName     String      @map("event_name")
  eventStartsAt DateTime    @map("event_starts_at")
  eventVenue    String      @map("event_venue")
  name          String
  email         String
  cpf           String?
  ticketHash    String      @unique @map("ticket_hash")
  status        GuestStatus @default(ACTIVE)
  checkedInAt   DateTime?   @map("checked_in_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@unique([eventId, cpf])
  @@index([cpf])
  @@index([email])
  @@index([eventId, status])
  @@map("guests")
}

model AdminSession {
  id         String    @id @default(uuid())
  tokenId    String    @unique @map("token_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@index([expiresAt])
  @@map("admin_sessions")
}
